# Research observation only. Merge explicitly into your existing FX environment.
MT5_DEMO_ONLY=true
# Example for a measured UTC+3 broker feed: -10800. Keep 0 for UTC feeds.
FX_MT5_TIME_OFFSET_SECONDS=0
FX_LIVE_TRADING_ENABLED=false
FX_SNIPER_MODE=shadow
FX_SNIPER_STRUCTURE_STOP=false
FX_SNIPER_FAILURE_EXIT=false
FX_SNIPER_TIME_EXIT=false
FX_REQUIRE_NEWS_DATA=true
FX_NEWS_API_ENDPOINT=
FX_NEWS_API_KEY=
FX_NEWS_EVENTS_FILE=
FX_NEWS_EVENTS_JSON=
FX_USE_FOREX_FACTORY=true
FX_NEWS_SYNC_INTERVAL_SECONDS=300
FX_NEWS_DATA_MAX_AGE_SECONDS=3600
FX_NEWS_MANUAL_OVERRIDE=none
FX_NEWS_EVENT_OVERRIDES=
FX_AI_DELIBERATION=shadow
FX_AI_FLAG_BLOCKS=false
FX_AI_REJECT_BLOCKS=false
FX_AI_ADVISORY_REQUIRE_CONFIRMATION=false
# Free calendar is for demo only. Configure your existing AI endpoint separately.
# Unknown costs remain unknown. Fill these from broker-specific observations;
# do not assume zero commission or zero slippage for convenience.
FX_SNIPER_SLIPPAGE_PIPS_PER_SIDE=
FX_SNIPER_COMMISSION_PIPS_ROUND_TRIP=
FX_JSONL_JOURNAL=./data/fx_sniper_shadow.jsonl
