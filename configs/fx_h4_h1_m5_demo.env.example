# FX H4/H1/M15 entry with optional M5 TP profile; merge these into your existing .env.
# Existing environment values override code defaults until changed explicitly.
FX_ENTRY_TIMEFRAME=15m
FX_HTF_TIMEFRAME=4h
FX_STRUCTURE_TIMEFRAME=1h
FX_STRUCTURE_ADX_MIN=18
FX_STRUCTURE_MA28_SLOPE_LOOKBACK=3
# Keep the real-money safety controls unchanged.
MT5_DEMO_ONLY=true
FX_LIVE_TRADING_ENABLED=false
# Optional: enables completed M5 ATR target sizing, independent of H4 bias.
FX_TP_TIMEFRAME=5m
